<Project>
  <ItemGroup>
    <Compile Include="$(RepoRoot)src/Shared/Polyfills/**/*.cs" Link="Shared/Polyfills/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0' or '$(TargetFrameworkIdentifier)' == '.NETFramework'">
    <PackageReference Include="System.Memory" />
  </ItemGroup>
</Project>
