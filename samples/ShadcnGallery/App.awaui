@using AwAUI.Shadcn
@using ShadcnGallery
@using AwAUI.Icons.Lucide
@using AwAUI.Controls.Primitives

<div class="docs-root">
    <div class="docs-sidebar" role="navigation" aria-label="Component navigation">
        @(Brand())
        <div class="docs-search">@(SearchBox())</div>
        <div class="docs-nav">@(Nav())</div>
        <div class="docs-sidebar-footer">
            <text class="docs-footer-text">AwAUI · shadcn components</text>
        </div>
    </div>
    <div class="docs-main">
        <div class="docs-header">
            <div class="docs-header-left">
                @(MobileMenuButton())
                <div class="docs-breadcrumb">@(Breadcrumb())</div>
            </div>
            <div class="docs-header-actions">
                <AwAUI.Shadcn.Badge Variant="BadgeVariant.Outline" Class="docs-version">new-york-v4</AwAUI.Shadcn.Badge>
                <AwAUI.Shadcn.Button Variant="ButtonVariant.Ghost" Size="ButtonSize.IconSm" @onclick="ToggleTheme" aria-label="Toggle theme">
                    @(ThemeIcon())
                </AwAUI.Shadcn.Button>
            </div>
        </div>
        <div class="docs-content">@(ContentView())</div>
    </div>
</div>
@(MobileSheet())

@code {
    readonly State<string> _pageId = new("introduction");
    readonly State<string> _query = new("");
    readonly State<bool> _dark = new(false);
    readonly State<bool> _mobileOpen = new(false);
    readonly State<string?> _openCode = new((string?)null);
    readonly ScrollController _contentScroll = new();

    public bool Dark { get; set; }
    public string? Page { get; set; }

    protected override void OnMount()
    {
        _dark.Value = Dark;
        ApplyTheme();
        if (!string.IsNullOrEmpty(Page)) _pageId.Value = Page!;
    }

    DocsPage Current => DocsCatalog.Find(_pageId.Value);

    void Select(string id)
    {
        _pageId.Value = id;
        _openCode.Value = null;
        _mobileOpen.Value = false;
        _ = _contentScroll.ScrollTo(0, 0);
    }

    void ToggleTheme()
    {
        _dark.Value = !_dark.Value;
        ApplyTheme();
    }

    void ApplyTheme()
    {
        if (Root is { } root) ShadcnTheme.SetDark(root, _dark.Value);
    }

    void ToggleCode(string key) => _openCode.Value = _openCode.Value == key ? null : key;

    Node Brand()
    {
        var button = new AwAUI.Shadcn.Button
        {
            Variant = ButtonVariant.Ghost,
            Size = ButtonSize.Lg,
            OnClick = _ => Select("introduction"),
            Class = "docs-brand-button",
        };
        var rest = button.Rest ??= new AttributeDictionary();
        rest["style"] = "height:auto;justify-content:flex-start;padding:2px 6px 14px;gap:10px;width:100%;";
        button.Children ??= new NodeList();
        button.Children.Add(new AwAUI.UI.Div { Class = "docs-logo", Children = new NodeList([new TextNode("Aw")]) });
        button.Children.Add(new AwAUI.UI.Div
        {
            Class = "demo-column",
            Children = new NodeList(
            [
                new AwAUI.UI.Text { Class = "docs-brand-name", Content = "AwAUI" },
                new AwAUI.UI.Text { Class = "docs-brand-sub", Content = "shadcn components" },
            ]),
        });
        rest["aria-label"] = "Go to Introduction";
        return button;
    }

    Node SearchBox()
    {
        var input = new AwAUI.Shadcn.Input
        {
            Class = "docs-search-input",
            Placeholder = "Search components…",
            Value = _query.Value,
            ValueChanged = value => _query.Value = value ?? "",
        };
        input.Rest ??= new AttributeDictionary();
        input.Rest["aria-label"] = "Search components";
        return input;
    }

    Node Nav()
    {
        var nav = new AwAUI.UI.Div { Class = "docs-nav" };
        string query = _query.Value.Trim();
        nav.Children.Add(new AwAUI.UI.Text { Class = "docs-nav-heading", Content = "Getting Started" });
        foreach (var page in DocsCatalog.GettingStarted)
            nav.Children.Add(NavLink(page, query));
        nav.Children.Add(new AwAUI.UI.Text { Class = "docs-nav-heading", Content = "Components" });
        var components = DocsCatalog.Components;
        int shown = 0;
        foreach (var page in components)
        {
            if (query.Length > 0 && page.Title.IndexOf(query, StringComparison.OrdinalIgnoreCase) < 0) continue;
            nav.Children.Add(NavLink(page, query));
            shown++;
        }
        if (shown == 0 && query.Length > 0)
            nav.Children.Add(new AwAUI.UI.Text { Class = "docs-empty", Content = "No components found." });
        return nav;
    }

    Node NavLink(DocsPage page, string query)
    {
        bool active = page.Id == _pageId.Value;
        var button = new AwAUI.Shadcn.Button
        {
            Variant = ButtonVariant.Ghost,
            Size = ButtonSize.Sm,
            OnClick = _ => Select(page.Id),
            Class = "docs-nav-link",
            Children = new NodeList([new TextNode(page.Title)]),
        };
        button.Rest ??= new AttributeDictionary();
        button.Rest["style"] = active
            ? "width:100%;height:32px;justify-content:flex-start;padding:0 8px;font-size:13px;font-weight:500;background:var(--accent);color:var(--foreground);"
            : "width:100%;height:32px;justify-content:flex-start;padding:0 8px;font-size:13px;font-weight:500;";
        button.Rest["data-active"] = active ? "true" : null;
        if (active) button.Rest["aria-current"] = "page";
        return button;
    }

    Node Breadcrumb()
    {
        var page = Current;
        var row = new AwAUI.UI.Div { Class = "docs-breadcrumb" };
        row.Children.Add(new AwAUI.UI.Text { Content = page.Section == DocsSection.Components ? "Components" : "Getting Started" });
        row.Children.Add(new AwAUI.UI.Text { Content = "/" });
        row.Children.Add(new AwAUI.UI.Text { Class = "docs-breadcrumb-current", Content = page.Title });
        return row;
    }

    Node ThemeIcon()
    {
        var svg = new AwAUI.UI.Svg(_dark.Value ? LucideIcons.Sun : LucideIcons.Moon) { Class = "size-4" };
        svg.Attributes["aria-hidden"] = "true";
        return svg;
    }

    Node MobileMenuButton()
    {
        var button = new AwAUI.Shadcn.Button
        {
            Variant = ButtonVariant.Ghost,
            Size = ButtonSize.IconSm,
            OnClick = _ => _mobileOpen.Value = true,
            Class = "docs-menu",
        };
        var svg = new AwAUI.UI.Svg(LucideIcons.PanelLeft) { Class = "size-4" };
        svg.Attributes["aria-hidden"] = "true";
        button.Children ??= new NodeList();
        button.Children.Add(svg);
        var rest = button.Rest ??= new AttributeDictionary();
        rest["aria-label"] = "Open navigation";
        return button;
    }

    Node MobileSheet()
    {
        var content = new AwAUI.UI.Div { Class = "docs-mobile-nav", Children = new NodeList([Nav()]) };
        var sheet = new AwAUI.Shadcn.Sheet
        {
            Open = _mobileOpen.Value,
            OnOpenChange = value => _mobileOpen.Value = value,
            Children = new NodeList(
            [
                new AwAUI.Shadcn.SheetContent
                {
                    Side = Side.Left,
                    Class = "docs-sheet",
                    Children = new NodeList(
                    [
                        new AwAUI.Shadcn.SheetHeader
                        {
                            Children = new NodeList(
                            [
                                new AwAUI.Shadcn.SheetTitle { Children = new NodeList([new TextNode("AwAUI · shadcn")]) },
                                new AwAUI.Shadcn.SheetDescription { Children = new NodeList([new TextNode("Browse the component reference")]) },
                            ]),
                        },
                        content,
                    ]),
                },
            ]),
        };
        return sheet;
    }

    Node ContentView()
    {
        _ = _query.Value;
        _ = _openCode.Value;
        var page = Current;
        var article = new AwAUI.UI.Div { Class = "docs-article" };
        article.Children.Add(new AwAUI.UI.Text { Class = "docs-kicker", Content = page.Section == DocsSection.Components ? "Components" : "Getting Started" });
        var title = new AwAUI.UI.Text { Class = "docs-title", Content = page.Title, Role = Role.Heading };
        title.Attributes["aria-level"] = "1";
        article.Children.Add(title);
        article.Children.Add(new AwAUI.UI.Text { Class = "docs-description", Content = page.Description });

        if (page.Section == DocsSection.GettingStarted)
        {
            if (page.Examples.Count > 0)
                article.Children.Add(new AwAUI.UI.Div { Class = "docs-guide", Children = new NodeList([page.Examples[0].Build()]) });
        }
        else
        {
            foreach (var example in page.Examples)
                article.Children.Add(ExampleCard(page, example));
        }

        var (previous, next) = DocsCatalog.Neighbors(page);
        if (previous is not null || next is not null)
            article.Children.Add(Pager(previous, next));

        return new AwAUI.UI.Div { Class = "docs-scroll", ScrollController = _contentScroll, Children = new NodeList([article]) };
    }

    Node ExampleCard(DocsPage page, DocsExample example)
    {
        string key = page.Id + ":" + example.Title;
        var card = new AwAUI.UI.Div { Class = "docs-example" };
        card.Children.Add(new AwAUI.UI.Div { Class = "docs-preview", Children = new NodeList([example.Build()]) });
        var footer = new AwAUI.UI.Div { Class = "docs-example-footer" };
        footer.Children.Add(new AwAUI.UI.Text { Class = "docs-example-title", Content = example.Title });
        if (example.Code is not null)
        {
            bool open = _openCode.Value == key;
            var toggle = new AwAUI.Shadcn.Button
            {
                Variant = ButtonVariant.Ghost,
                Size = ButtonSize.Xs,
                OnClick = _ => ToggleCode(key),
                Class = "docs-code-toggle",
                Children = new NodeList([new TextNode(open ? "Hide code" : "Code")]),
            };
            toggle.Rest ??= new AttributeDictionary();
            toggle.Rest["aria-expanded"] = open ? "true" : "false";
            footer.Children.Add(toggle);
        }
        card.Children.Add(footer);
        if (example.Code is not null && _openCode.Value == key)
        {
            var code = new AwAUI.Shadcn.CodeBlock
            {
                Code = example.Code,
                Language = "awaui",
                FileName = page.Id + ".awaui",
                ShowLineNumbers = true,
                Class = "docs-example-code",
            };
            card.Children.Add(code);
        }
        return card;
    }

    Node Pager(DocsPage? previous, DocsPage? next)
    {
        var pager = new AwAUI.UI.Div { Class = "docs-pager" };
        if (previous is not null) pager.Children.Add(PagerButton("Previous", previous, true));
        else pager.Children.Add(new AwAUI.UI.Div());
        if (next is not null) pager.Children.Add(PagerButton("Next", next, false));
        else pager.Children.Add(new AwAUI.UI.Div());
        return pager;
    }

    Node PagerButton(string direction, DocsPage page, bool previous)
    {
        var button = new AwAUI.Shadcn.Button
        {
            Variant = ButtonVariant.Ghost,
            Size = ButtonSize.Sm,
            OnClick = _ => Select(page.Id),
            Class = "docs-pager-button",
        };
        button.Rest ??= new AttributeDictionary();
        button.Rest["style"] = previous
            ? "height:auto;align-items:flex-start;padding:8px 10px;"
            : "height:auto;align-items:flex-end;padding:8px 10px;";
        var label = new AwAUI.UI.Div { Class = "demo-row" };
        if (previous) label.Children.Add(Glyph(LucideIcons.ChevronLeft));
        label.Children.Add(new AwAUI.UI.Text { Class = "docs-pager-direction", Content = direction });
        if (!previous) label.Children.Add(Glyph(LucideIcons.ChevronRight));
        button.Children ??= new NodeList();
        button.Children.Add(label);
        button.Children.Add(new AwAUI.UI.Text { Class = "docs-pager-title", Content = page.Title });
        return button;
    }

    static AwAUI.UI.Svg Glyph(AwAUI.Svg.SvgDocument document)
    {
        var svg = new AwAUI.UI.Svg(document) { Class = "size-3" };
        svg.Attributes["aria-hidden"] = "true";
        return svg;
    }
}
