<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <!-- dotnet publish -c Release -r osx-arm64 -p:NativeAot=true -->
    <PublishAot Condition="'$(NativeAot)' == 'true'">true</PublishAot>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/AwAUI.Render/AwAUI.Render.csproj" />
    <!-- GPU（Metal）后端与「GPU 可用则用 GPU」的组合根助手 MetalRenderer；非 Apple 平台上自动退回软件 -->
    <ProjectReference Include="../../src/Rhi/AwAUI.Rhi.Metal/AwAUI.Rhi.Metal.csproj" />
    <ProjectReference Include="../../src/AwAUI.Imaging/AwAUI.Imaging.csproj" />
    <ProjectReference Include="../../src/Headless/AwAUI.Headless/AwAUI.Headless.csproj" />
    <ProjectReference Include="../../src/MacOS/AwAUI.MacOS/AwAUI.MacOS.csproj" />
    <ProjectReference Include="../../src/Windows/AwAUI.Win32/AwAUI.Win32.csproj" />
    <ProjectReference Include="../../src/Linux/AwAUI.X11/AwAUI.X11.csproj" />
  </ItemGroup>
</Project>
