@* shadcn/ui v4 Card：头部、标题、描述、内容、页脚各是独立的部件（组合式 API），这里用插槽 Header / Footer 简化 *@
<div data-slot="card" class="@Cn("bg-card text-card-foreground flex flex-col gap-6 rounded-xl border py-6 shadow-sm", Class)" @attributes="Rest">
    @if (Title != null || Description != null)
    {
        <div data-slot="card-header" class="@@container/card-header grid auto-rows-min grid-rows-[auto_auto] items-start gap-1.5 px-6 has-data-[slot=card-action]:grid-cols-[1fr_auto] [.border-b]:pb-6">
            @if (Title != null)
            {
                <text data-slot="card-title" class="leading-none font-semibold">@Title</text>
            }
            @if (Description != null)
            {
                <text data-slot="card-description" class="text-muted-foreground text-sm">@Description</text>
            }
            @if (Action != null)
            {
                <div data-slot="card-action" class="col-start-2 row-span-2 row-start-1 self-start justify-self-end">@Action</div>
            }
        </div>
    }
    <div data-slot="card-content" class="px-6">@Children</div>
    @if (Footer != null)
    {
        <div data-slot="card-footer" class="flex items-center gap-2 px-6 [.border-t]:pt-6">@Footer</div>
    }
</div>

@code {
    static string Cn(string a, string? b) => AwAUI.Tailwind.TailwindMerge.Cn(a, b);

    public string? Title { get; set; }
    public string? Description { get; set; }
    public string? Class { get; set; }
    public NodeList? Action { get; set; }
    public NodeList? Children { get; set; }
    public NodeList? Footer { get; set; }
    [CaptureUnmatchedAttributes] public AttributeDictionary? Rest { get; set; }
}
