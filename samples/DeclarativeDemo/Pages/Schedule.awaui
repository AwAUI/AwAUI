<div class="page schedule">
    <div class="page-head">
        <div class="page-head-copy">
            <text class="page-kicker">Planning</text>
            <text class="page-title">Schedule</text>
            <text class="page-subtitle">Pick a range for the next sprint. Weekends and the winter break are disabled, and the summary updates as you click.</text>
        </div>
        <div class="page-actions">
            <AwAUI.Shadcn.Button Variant="ButtonVariant.Outline" @onclick="ClearRange">Clear range</AwAUI.Shadcn.Button>
            <AwAUI.Shadcn.Button @onclick="NotifyTeam"><Svg Document="@LucideIcons.Plus" Class="icon-16" />Share with team</AwAUI.Shadcn.Button>
        </div>
    </div>

    <div class="schedule-grid">
        <AwAUI.Shadcn.Card Class="schedule-calendar-card">
            <AwAUI.Shadcn.CardHeader>
                <div class="spread">
                    <div class="stack">
                        <AwAUI.Shadcn.CardTitle>Team calendar</AwAUI.Shadcn.CardTitle>
                        <AwAUI.Shadcn.CardDescription>Two months, range selection, disabled weekends and holidays.</AwAUI.Shadcn.CardDescription>
                    </div>
                    <AwAUI.Shadcn.Badge Variant="BadgeVariant.Outline">Sprint 24</AwAUI.Shadcn.Badge>
                </div>
            </AwAUI.Shadcn.CardHeader>
            <AwAUI.Shadcn.CardContent>
                <AwAUI.Shadcn.Calendar SelectionMode="CalendarSelectionMode.Range" IsRangeControlled="true"
                          RangeStart="@_rangeStart.Value" RangeEnd="@_rangeEnd.Value" RangeChanged="OnRangeChanged"
                          NumberOfMonths="2" DisabledDates="IsDateDisabled" ShowOutsideDays="false"
                          Class="schedule-calendar" />
            </AwAUI.Shadcn.CardContent>
        </AwAUI.Shadcn.Card>

        <div class="schedule-side">
            <AwAUI.Shadcn.Card>
                <AwAUI.Shadcn.CardHeader>
                    <AwAUI.Shadcn.CardTitle>Selected range</AwAUI.Shadcn.CardTitle>
                    <AwAUI.Shadcn.CardDescription>The inclusive span you have chosen.</AwAUI.Shadcn.CardDescription>
                </AwAUI.Shadcn.CardHeader>
                <AwAUI.Shadcn.CardContent>
                    @if (HasCompleteRange)
                    {
                        <div class="range-head">
                            <text class="range-days">@RangeDays</text>
                            <text class="tiny">days selected</text>
                        </div>
                        <text class="muted">@RangeText</text>
                    }
                    else if (_rangeStart.Value is not null)
                    {
                        <div class="range-head"><text class="range-days">1</text><text class="tiny">start date chosen</text></div>
                        <text class="muted">Pick an end date to complete the range.</text>
                    }
                    else
                    {
                        <text class="muted">Select a start date on the calendar.</text>
                    }
                    <div class="row schedule-range-actions">
                        <AwAUI.Shadcn.Button Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" @onclick="ClearRange">Clear</AwAUI.Shadcn.Button>
                        <AwAUI.Shadcn.Button Size="ButtonSize.Sm" @onclick="NotifyTeam">Share</AwAUI.Shadcn.Button>
                    </div>
                </AwAUI.Shadcn.CardContent>
            </AwAUI.Shadcn.Card>

            <AwAUI.Shadcn.Card>
                <AwAUI.Shadcn.CardHeader>
                    <AwAUI.Shadcn.CardTitle>Availability</AwAUI.Shadcn.CardTitle>
                    <AwAUI.Shadcn.CardDescription>Who can join during the selected range.</AwAUI.Shadcn.CardDescription>
                </AwAUI.Shadcn.CardHeader>
                <AwAUI.Shadcn.CardContent>
                    <div class="availability-list">
                        @foreach (var member in SampleData.Team)
                        {
                            <div class="availability-row" @key="member.Name">
                                <AwAUI.Shadcn.Avatar Size="AvatarSize.Sm"><AwAUI.Shadcn.AvatarFallback>@member.Initials</AwAUI.Shadcn.AvatarFallback></AwAUI.Shadcn.Avatar>
                                <div class="availability-copy">
                                    <text class="availability-name">@member.Name</text>
                                    <text class="tiny">@member.Role</text>
                                </div>
                                <AwAUI.Shadcn.Badge Variant="@AvailabilityVariant(member.Name)">@Availability(member.Name)</AwAUI.Shadcn.Badge>
                            </div>
                        }
                    </div>
                </AwAUI.Shadcn.CardContent>
            </AwAUI.Shadcn.Card>

            <AwAUI.Shadcn.Card>
                <AwAUI.Shadcn.CardHeader>
                    <AwAUI.Shadcn.CardTitle>Blocked dates</AwAUI.Shadcn.CardTitle>
                    <AwAUI.Shadcn.CardDescription>Disabled days are skipped by the calendar.</AwAUI.Shadcn.CardDescription>
                </AwAUI.Shadcn.CardHeader>
                <AwAUI.Shadcn.CardContent>
                    <div class="blocked-list">
                        <div class="blocked-row"><text class="blocked-day">Weekends</text><text class="tiny">Always unavailable</text></div>
                        <div class="blocked-row"><text class="blocked-day">Nov 25</text><text class="tiny">Company offsite</text></div>
                        <div class="blocked-row"><text class="blocked-day">Dec 24 – Jan 2</text><text class="tiny">Winter break</text></div>
                    </div>
                </AwAUI.Shadcn.CardContent>
            </AwAUI.Shadcn.Card>
        </div>
    </div>
</div>
