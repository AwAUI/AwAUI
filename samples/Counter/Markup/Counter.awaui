@* design/05 的计数器（.awaui 写法）：与 Components.cs 中纯 C# 的 Counter 产出相同的元素树与画面。 *@
<div class="counter">
    <text class="count" id="count">@(Strings.Current.Count + count.Value)</text>
    <div class="actions">
        <Button class="secondary" id="decrement" @onclick="() => count.Value -= Step">@Strings.Current.Decrement</Button>
        <Button class="primary" id="increment" @onclick="() => count.Value += Step">@Strings.Current.Increment</Button>
    </div>
</div>

@code {
    /// <summary>步长（可写 Props：父组件改变它时原地采纳，计数保留）。</summary>
    public int Step { get; set; } = 1;

    readonly State<int> count = new(0);
}

<style>
    /* 作用域样式：选择器由编译器附加本组件的作用域属性，只匹配本组件 Build() 产出的元素 */
    .counter {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .count {
        padding: 14px 0;
        border-radius: 10px;
        background-image: linear-gradient(135deg, #eef2ff, #e0f2fe);
        font-size: 26px;
        font-weight: 600;
        text-align: center;
        color: #1e1b4b;
    }

    .actions {
        display: flex;
        gap: 10px;
    }

    .actions > button {
        flex: 1;
        height: 40px;
        border-radius: 10px;
        font-size: 15px;
        cursor: pointer;
    }
</style>

<style global>
    /* 按钮外观在整个应用中共用（表单的「问好」按钮也用 primary）：全局样式，随本组件首次挂载注册 */
    button.primary {
        color: #ffffff;
        border: 1px solid var(--accent-strong);
        background-color: var(--accent);
        background-image: linear-gradient(180deg, #6372f1, #4f46e5);
        box-shadow: 0 2px 6px rgba(79, 70, 229, 0.35), inset 0 1px 0 rgba(255, 255, 255, 0.18);
        cursor: pointer;
    }
    button.primary:hover { background-image: linear-gradient(180deg, #7280f4, #5a52ec); }
    button.primary:active { background-image: none; background-color: var(--accent-strong); box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.2); }
    button.primary.small { padding: 0 16px; height: 34px; border-radius: 8px; }

    button.secondary {
        color: var(--ink);
        background-color: #ffffff;
        border: 1px solid #d5dbe5;
        box-shadow: 0 1px 2px rgba(26, 43, 74, 0.08);
    }
    button.secondary:hover { background-color: #f5f7fb; }
    button.secondary:active { background-color: #eceff5; }
</style>
