<div data-slot="card"
     class="@AwAUI.Tailwind.TailwindMerge.Cn("flex flex-col gap-6 rounded-xl border bg-card py-6 text-card-foreground shadow-sm", Class)"
     @attributes="Rest">
    @Children
</div>

@code {
    public string? Class { get; set; }
    public NodeList? Children { get; set; }
    [CaptureUnmatchedAttributes] public AttributeDictionary? Rest { get; set; }
}
