@inherits global::AwAUI.Controls.Primitives.SlottableComponent
@using AwAUI.Controls.Primitives

@(BuildButton())

@code {
    static readonly AwAUI.Tailwind.Cva<ButtonVariant, ButtonSize> Variants = new(
        "inline-flex shrink-0 items-center justify-center gap-2 rounded-md text-sm font-medium whitespace-nowrap transition-all outline-none select-none focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50 active:not-aria-[haspopup]:translate-y-px disabled:pointer-events-none disabled:opacity-50 aria-invalid:border-destructive aria-invalid:ring-destructive/20 dark:aria-invalid:ring-destructive/40 [&_svg]:pointer-events-none [&_svg]:shrink-0 [&_svg:not([class*='size-'])]:size-4",
        new Dictionary<ButtonVariant, string>
        {
            [ButtonVariant.Default] = "bg-primary text-primary-foreground hover:bg-primary/90",
            [ButtonVariant.Destructive] = "bg-destructive text-white hover:bg-destructive/90 focus-visible:ring-destructive/20 dark:bg-destructive/60 dark:focus-visible:ring-destructive/40",
            [ButtonVariant.Outline] = "border bg-background shadow-xs hover:bg-accent hover:text-accent-foreground dark:border-input dark:bg-input/30 dark:hover:bg-input/50",
            [ButtonVariant.Secondary] = "bg-secondary text-secondary-foreground hover:bg-secondary/80",
            [ButtonVariant.Ghost] = "hover:bg-accent hover:text-accent-foreground dark:hover:bg-accent/50",
            [ButtonVariant.Link] = "text-primary underline-offset-4 hover:underline",
        },
        new Dictionary<ButtonSize, string>
        {
            [ButtonSize.Default] = "h-9 px-4 py-2 has-[>svg]:px-3",
            [ButtonSize.Xs] = "h-6 gap-1 rounded-md px-2 text-xs has-[>svg]:px-1.5 [&_svg:not([class*='size-'])]:size-3",
            [ButtonSize.Sm] = "h-8 gap-1.5 rounded-md px-3 has-[>svg]:px-2.5",
            [ButtonSize.Lg] = "h-10 rounded-md px-6 has-[>svg]:px-4",
            [ButtonSize.Icon] = "size-9",
            [ButtonSize.IconXs] = "size-6 rounded-md [&_svg:not([class*='size-'])]:size-3",
            [ButtonSize.IconSm] = "size-8",
            [ButtonSize.IconLg] = "size-10",
        });

    ElementNode? _slot;

    public ButtonVariant Variant { get; set; }
    public ButtonSize Size { get; set; }
    public bool Disabled { get; set; }
    public bool AsChild { get; set; }
    public string? Class { get; set; }
    public Ref<Element>? Ref { get; set; }
    public Action<PointerEvent>? OnClick { get; set; }
    public NodeList? Children { get; set; }
    [CaptureUnmatchedAttributes] public AttributeDictionary? Rest { get; set; }

    Node BuildButton()
    {
        var button = new global::AwAUI.UI.Button
        {
            Class = Variants.Of(Variant, Size, Class), Disabled = Disabled, Ref = Ref, OnClick = OnClick,
            Children = Children ?? new NodeList(),
        };
        button.Attributes["data-slot"] = "button";
        button.Attributes["data-variant"] = Variant.ToString().ToLowerInvariant();
        button.Attributes["data-size"] = Size switch
        {
            ButtonSize.IconXs => "icon-xs", ButtonSize.IconSm => "icon-sm", ButtonSize.IconLg => "icon-lg",
            _ => Size.ToString().ToLowerInvariant(),
        };
        button.MergeAttributes(Rest);
        Node node = AsChild ? Slot.Merge(button, Slot.SingleChild(Children)) : button;
        if (_slot is not null && node is not Fragment) node = Slot.Merge(_slot, node);
        if (node is ElementNode element) element.Class = AwAUI.Tailwind.TailwindMerge.Cn(element.Class.Text);
        return node;
    }

    public override Node MergeSlotProps(ElementNode slotProps) => new Button
    {
        _slot = _slot is null ? slotProps : (ElementNode)Slot.Merge(slotProps, _slot), Key = Key ?? slotProps.Key,
        Variant = Variant, Size = Size, Disabled = Disabled, AsChild = AsChild, Class = Class, Ref = Ref,
        OnClick = OnClick, Children = Children, Rest = Rest,
    };

    // Include the slot in reconciliation so changes to aria-expanded or the trigger handler reach the existing element.
    protected override bool PropsEqual(Component other) => other is Button b
        && ReferenceEquals(_slot, b._slot) && Variant == b.Variant && Size == b.Size && Disabled == b.Disabled
        && AsChild == b.AsChild && Class == b.Class && ReferenceEquals(Ref, b.Ref) && OnClick == b.OnClick
        && ReferenceEquals(Children, b.Children) && ReferenceEquals(Rest, b.Rest);

    protected override void AdoptProps(Component other)
    {
        var b = (Button)other;
        _slot = b._slot;
        Variant = b.Variant;
        Size = b.Size;
        Disabled = b.Disabled;
        AsChild = b.AsChild;
        Class = b.Class;
        Ref = b.Ref;
        OnClick = b.OnClick;
        Children = b.Children;
        Rest = b.Rest;
    }
}
