@using AwAUI.Controls.Primitives

@(BuildToggle())

@code {
    readonly ControllableState<bool> _pressed = new();

    public string? Id { get; set; }
    public bool? Pressed { get; set; }
    public bool DefaultPressed { get; set; }
    public Action<bool>? PressedChanged { get; set; }
    public Action<bool>? OnPressedChange { get; set; }
    public bool Disabled { get; set; }
    public ToggleVariant Variant { get; set; }
    public ToggleSize Size { get; set; }
    public string? Class { get; set; }
    public string? Style { get; set; }
    public Ref<Element>? Ref { get; set; }
    public Action<PointerEvent>? OnClick { get; set; }
    public NodeList? Children { get; set; }
    [CaptureUnmatchedAttributes] public AttributeDictionary? Rest { get; set; }

    Node BuildToggle()
    {
        bool pressed = _pressed.Sync(Pressed, DefaultPressed, PressedChanged + OnPressedChange);
        var button = new global::AwAUI.UI.Button
        {
            Id = Id, Disabled = Disabled, Style = Style, Ref = Ref, OnClick = OnClick,
            Children = Children ?? new NodeList(),
        };
        var attributes = VisualPart.Attributes("toggle",
            ToggleStyles.Base + " " + ToggleStyles.Variant(Variant) + " " + ToggleStyles.Size(Size), Class, Rest);
        attributes["role"] ??= Role.Button;
        button.MergeAttributes(attributes);
        button.Attributes["type"] = "button";
        button.Attributes["data-variant"] = ToggleStyles.VariantName(Variant);
        button.Attributes["data-size"] = ToggleStyles.SizeName(Size);
        button.Attributes["aria-pressed"] = pressed ? "true" : "false";
        button.Attributes["data-state"] = pressed ? "on" : "off";
        button.Attributes["data-disabled"] = button.Disabled ? "" : null;
        button.OnClick = EventComposition.Compose(button.OnClick, e =>
        {
            if (!e.DefaultPrevented && !button.Disabled) _pressed.Set(!_pressed.Value);
        });
        return button;
    }
}
