@(BuildBadge())

@code {
    const string BadgeClass =
        "absolute right-0 bottom-0 z-10 inline-flex items-center justify-center rounded-full bg-primary text-primary-foreground ring-2 ring-background select-none " +
        "group-data-[size=sm]/avatar:size-2 group-data-[size=sm]/avatar:[&>svg]:hidden " +
        "group-data-[size=default]/avatar:size-2.5 group-data-[size=default]/avatar:[&>svg]:size-2 " +
        "group-data-[size=lg]/avatar:size-3 group-data-[size=lg]/avatar:[&>svg]:size-2";

    public string? Class { get; set; }
    public string? Style { get; set; }
    public Ref<Element>? Ref { get; set; }
    public NodeList? Children { get; set; }
    [CaptureUnmatchedAttributes] public AttributeDictionary? Rest { get; set; }

    Node BuildBadge()
    {
        var badge = new global::AwAUI.UI.Span
        {
            Style = Style, Ref = Ref, Children = Children ?? new NodeList(),
        };
        badge.MergeAttributes(VisualPart.Attributes("avatar-badge", BadgeClass, Class, Rest));
        return badge;
    }
}
