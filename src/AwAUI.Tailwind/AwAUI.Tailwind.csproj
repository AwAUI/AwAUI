<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Tailwind CSS v4 兼容的工具类引擎（design/23 第 3 层、决策 D41）。
    只输出 CSS 文本，不依赖任何 AwAUI 运行时程序集，可被 Roslyn 源生成器（netstandard2.0）直接引用。
  -->
  <Import Project="$(RepoRoot)build/TargetFrameworks.props" />
  <Import Project="$(RepoRoot)build/Polyfills.props" />
  <PropertyGroup>
    <RootNamespace>AwAUI.Tailwind</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <None Include="THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="" />
  </ItemGroup>
</Project>
