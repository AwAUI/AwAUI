@* 计数器：@code 中的 State、Props，以及代码后置文件 Counter.awaui.cs *@
<div class="counter">
    <text class="value">@Label：@count.Value</text>
    <Button class="inc" @onclick="Increment">+@Step</Button>
    @if (count.Value >= Limit)
    {
        <text class="limit">已到上限</text>
    }
</div>

@code {
    public int Step { get; set; } = 1;

    readonly State<int> count = new(0);

    void Increment() => count.Value = Math.Min(Limit, count.Value + Step);
}

<style>
    .counter { display: flex; gap: 4px; }
    .counter > .value::after { content: ""; }
</style>
