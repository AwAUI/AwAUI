    <ProjectReference Include="../../src/AwAUI.Render/AwAUI.Render.csproj" />
    <ProjectReference Include="../../src/AwAUI.Imaging/AwAUI.Imaging.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- 字型抽象（FontFace、FontMetrics 等）位于 AwAUI.Graphics -->
    <Using Include="AwAUI.Graphics.Text" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../Shared/ThreadCpuClock.cs" Link="Shared/ThreadCpuClock.cs" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Expected/*.txt" CopyToOutputDirectory="PreserveNewest" LinkBase="Expected" />
  </ItemGroup>
</Project>
